// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Photo {
  id           Int      @id @default(autoincrement())
  imageUrl     String
  title        String
  caption      String
  location     String
  takenAt      DateTime
  uploaderName String
  people       String   // JSON array of person names: ["Shea", "Rowan", "Keelin", "Kathy", "Gavin"]
  createdAt    DateTime @default(now())

  @@index([takenAt, createdAt])
}
